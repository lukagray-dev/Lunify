<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Main Browse Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar with Platform Selector and Search -->
        <!-- Top Bar with Platform Selector and Search.
             Positioned and padded identically to the top bar in activity_main.xml
             to ensure seamless horizontal and vertical symmetry. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Platform Selector - Set to a fixed 48dp height to match the menu button
                 in activity_main.xml for height symmetry. -->
            <LinearLayout
                android:id="@+id/platformSelector"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/ripple_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/ivPlatformIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_youtube"
                    android:contentDescription="Platform"/>

                <!-- Heading Text - Vertical gravity and disabled font padding ensure it aligns
                     perfectly with the icons on either side. -->
                <TextView
                    android:id="@+id/tvPlatformName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="YouTube"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Select platform"/>

            </LinearLayout>

            <!-- Search Bar Container - Height matches the 44dp standard to be symmetrical
                 across My Music, Browse, and Duo pages. -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_bar_height"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"/>

                <!-- Search EditText using standard SearchEditTextStyle to ensure exact
                     visual consistency across all search inputs in the application. -->
                <EditText
                    android:id="@+id/etSearch"
                    style="@style/SearchEditTextStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="Search for songs and artists"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Tab Layout - Configured to 48dp height to match the tab layouts in
             My Music and Duo pages, achieving perfect vertical alignment. -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_height"
            android:background="@color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/tabIndicator"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/tabSelectedText"
            app:tabTextAppearance="@style/TabTextAppearance"
            app:tabTextColor="@color/tabUnselectedText"/>

        <!-- ViewPager for Tab Content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabLayout"/>

        <!-- Spotify Container -->
        <FrameLayout
            android:id="@+id/spotifyContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"/>

        <!-- Sign-In Container (shown when not authenticated) -->
        <LinearLayout
            android:id="@+id/signInContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/backgroundColor"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabLayout">

            <!-- Icon -->
            <ImageView
                android:id="@+id/ivSignInIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/ic_youtube"
                android:contentDescription="Platform"
                app:tint="@color/colorAccent"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tvSignInTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Sign in to YouTube"
                android:textColor="@color/textPrimary"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvSignInDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="Sign in to browse videos, access your subscriptions, and manage your playlists"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"/>

            <!-- Sign-In Button -->
            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_google_signin_button"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:text="Sign in with Google"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/ModernLoadingSpinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Container for Channel Fragment -->
    <FrameLayout
        android:id="@+id/browseFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>
