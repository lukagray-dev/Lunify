<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Top Bar without dropdown.
         Padded and aligned identically to activity_main.xml, fragment_browse.xml, and fragment_duo.xml
         to establish perfect horizontal and vertical symmetry. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm">

        <!-- Downloads Title - Configured with 48dp height to match the action buttons and headers
             on other screens for uniform vertical layout flow. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/downloads"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Link Input Bar - Structured with standard 44dp height to look identical to the search
             bars in other app screens. -->
        <LinearLayout
            android:id="@+id/linkInputContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/search_bar_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md">

            <!-- Link EditText - Styled with SearchEditTextStyle for visual consistency
                 while retaining specific URL input and action properties. -->
            <EditText
                android:id="@+id/etLinkInput"
                style="@style/SearchEditTextStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Paste video or playlist link"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnExtract"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ripple_circle"
                android:src="@drawable/ic_download"
                android:contentDescription="Extract"
                android:padding="4dp"
                app:tint="@color/colorAccent" />

        </LinearLayout>

    </LinearLayout>

    <!-- Downloads Fragment Container - Margin top adjusted to 64dp to sit cleanly below the 64dp high top bar. -->
    <FrameLayout
        android:id="@+id/downloadsFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp" />

</FrameLayout>
