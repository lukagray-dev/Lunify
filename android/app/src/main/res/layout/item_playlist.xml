<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for a saved playlist item in BrowsePlaylistsFragment -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Playlist Thumbnail -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardThumbnail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivPlaylistThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Playlist thumbnail"
            tools:src="@drawable/ic_music_note"/>
    </androidx.cardview.widget.CardView>

    <!-- Playlist Title -->
    <TextView
        android:id="@+id/tvPlaylistTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/textDark"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/tvPlaylistInfo"
        app:layout_constraintEnd_toStartOf="@id/btnOptions"
        app:layout_constraintStart_toEndOf="@id/cardThumbnail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="My Favourite Playlist"/>

    <!-- Playlist Info (track count) -->
    <TextView
        android:id="@+id/tvPlaylistInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/textDarkSecondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnOptions"
        app:layout_constraintStart_toEndOf="@id/cardThumbnail"
        app:layout_constraintTop_toBottomOf="@id/tvPlaylistTitle"
        tools:text="12 tracks"/>

    <!-- Options/Delete button -->
    <ImageButton
        android:id="@+id/btnOptions"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/ripple_circle"
        android:src="@drawable/ic_close"
        android:padding="8dp"
        android:contentDescription="Delete playlist"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/textDarkSecondary"/>

</androidx.constraintlayout.widget.ConstraintLayout>
